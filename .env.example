# Port for the API server (the Vite dev server proxies /api to it)
API_PORT=8787

# Google Photos Picker API — OAuth 2.0 "Web application" client ID.
# Add http://localhost:5173 (dev) and your production origin as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Optional: pre-fill the Immich server URL in the import dialog.
IMMICH_DEFAULT_URL=

# Optional: comma-separated hostnames the Immich proxy may talk to (e.g. "photos.example.com,192.168.1.20").
# Leave empty to allow any host (fine when you run this app for yourself; set it when hosting for others).
IMMICH_ALLOWED_HOSTS=
